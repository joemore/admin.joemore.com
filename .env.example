NEXT_PUBLIC_SUPABASE_URL=https://api-supabase.joemore.com
# Public publishable key from your self-hosted Supabase stack.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key for protected media identity and upload-state writes.
# Use your existing self-hosted secret/service-role key; never expose publicly.
SUPABASE_SECRET_KEY=

# Cloudflare R2 Object Read & Write credentials scoped ONLY to joemore-com-cdn.
# See docs/media-library-setup.md. Never use NEXT_PUBLIC_ for these values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=joemore-com-cdn
R2_PUBLIC_BASE_URL=https://cdn.joemore.com
# This release deliberately accepts only u/ to protect existing bucket content.
R2_UPLOAD_PREFIX=u/
# Optional maximum original size in bytes; default is 2 GiB.
R2_MAX_FILE_SIZE_BYTES=2147483648
